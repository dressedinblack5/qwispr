{
  "name": "qwispr-vscode",
  "displayName": "Qwispr",
  "description": "Qwispr — hybrid quantum/classical code intelligence (analyze/search/testgen)",
  "publisher": "qwispr",
  "version": "0.1.0",
  "engines": { "vscode": "^1.85.0" },
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "qwispr.analyze", "title": "Qwispr: Analyze File" },
      { "command": "qwispr.search", "title": "Qwispr: Search Code" },
      { "command": "qwispr.testgen", "title": "Qwispr: Generate Tests" }
    ],
    "configuration": {
      "title": "Qwispr",
      "properties": {
        "qwispr.backend": { "type": "string", "default": "simulator", "description": "Qwispr backend (simulator|lightning|ibm|braket)" },
        "qwispr.cliPath": { "type": "string", "default": "", "description": "Override path to qwispr CLI (default: <workspace>/dist/src/cli.js)" }
      }
    }
  },
  "scripts": { "build": "tsc -p ." },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
