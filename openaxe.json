{
  "$schema": "https://openaxe.dev/schema.json",
  "name": "qwispr",
  "version": "0.1.0",
  "description": "Hybrid quantum/classical code intelligence — QAOA, VQE, Grover, QWalk, QSVM on PennyLane",
  "workspace": ".",
  "skills": {
    "directory": "skills",
    "autoLoad": ["analyze", "search", "testgen", "refactor", "orchestrator", "hardware", "learning", "mcp", "qaoa", "vqe", "qwalk", "grover"]
  },
  "mcp": {
    "servers": {
      "qwispr": {
        "command": "node",
        "args": ["dist/cli.js", "mcp", "--stdio"],
        "env": {
          "QWISPR_BACKEND": "simulator",
          "QWISPR_TELEMETRY": "0"
        },
        "tools": ["analyze", "search", "testgen", "refactor", "hardware"]
      }
    }
  },
  "agents": {
    "directory": "agents",
    "registry": "AGENTS.md"
  },
  "context": {
    "maxTokens": 100000,
    "spillStrategy": "streaming"
  },
  "kanban": {
    "board": ".omo/kanban.json"
  }
}