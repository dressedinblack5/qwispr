{
  "name": "qwispr",
  "version": "0.1.2",
  "description": "Quantum-enhanced general coding assistant on OpenAxe",
  "main": "dist/index.js",
  "bin": {
    "qwispr": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && npm run copy:py",
    "copy:py": "mkdir -p dist/skills/qaoa-agent dist/skills/vqe-agent dist/skills/hardware dist/skills/qwalk-agent && cp src/skills/qaoa-agent/qaoa.py dist/skills/qaoa-agent/ && cp src/skills/vqe-agent/vqe.py dist/skills/vqe-agent/ && cp src/skills/hardware/qpu.py dist/skills/hardware/ && cp src/skills/qwalk-agent/qwalk.py dist/skills/qwalk-agent/",
    "dev": "tsx watch src/cli.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:real": "node scripts/benchmark.js real",
    "benchmark": "node scripts/benchmark.js synthetic",
    "benchmark:report": "node scripts/benchmark.js report",
    "ci:smoke": "npm run build && npm test && BENCH_N=2 npm run benchmark",
    "docs:dev": "vitepress dev docs/site",
    "docs:build": "vitepress build docs/site",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "quantum",
    "coding-assistant",
    "openaxe",
    "qaoa",
    "optimization"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11",
    "vite": "^6.4.3",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "esbuild": "^0.25.12",
    "vite": "^6.4.3"
  },
  "files": [
    "dist",
    "README.md",
    "src/skills/vqe-agent/vqe.py",
    "src/skills/qaoa-agent/qaoa.py",
    "src/skills/hardware/qpu.py"
  ]
}
